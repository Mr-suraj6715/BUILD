# Database Connection (Default SQLite for instant local dev, switch to Supabase/PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# Production Supabase PostgreSQL:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Auth Secrets
JWT_SECRET="your-super-secret-jwt-key"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payments (Razorpay)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# Email Notifications (Resend)
RESEND_API_KEY=""

# Optional Cloudinary / S3
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
